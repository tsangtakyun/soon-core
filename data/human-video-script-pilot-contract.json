  "responsibilities": {
    "core": [
      "publish immutable style and template versions",
      "return the exact pilot contract and preparation gaps",
      "reject a response when a published ID or content hash drifts"
    ],
    "consumer": [
      "enforce the signed-in workspace and user permissions",
      "persist drafts only inside the requesting workspace",
      "reuse the shared script and approval implementation across EGG web, EGG app and Content Studio",
      "keep legacy script_flow drafts readable and reopenable"
    ]
  },
  "legacy_compatibility": {
    "read": ["script_flow"],
    "reopen_without_migration": true,
    "write_schema": "human_video_script.v2",
    "approval_owner": "shared_consumer_service"
  },
  "permissions": {
    "core_does_not_authorize_workspace_access": true,
    "cross_product_does_not_grant_cross_workspace_access": true,
    "consumer_must_check_workspace_membership": true,
    "consumer_must_check_write_permission_before_save": true,
    "core_response_contains_no_workspace_content": true
  },
  "excluded_capabilities": [
    "editing_timeline",
    "automatic_video_editing",
    "video_generation",
    "direct_social_publishing",
    "automatic_style_publication"
  ],
  "paid_ai": {
    "enabled": false,
    "model_calls_in_core_pilot": 0,
    "approval_required_before_test": true
  },
  "request": {
    "required": ["consumer", "format", "brief"],
    "consumer_values": ["egg", "creator"],
